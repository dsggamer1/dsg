[Unit]
Description=NEX CODEX Discord bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nex
WorkingDirectory=/opt/nex-codex
EnvironmentFile=/etc/nex-codex.env
ExecStart=/opt/nex-codex/.venv/bin/python -m nex.bot
Restart=on-failure
RestartSec=10
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
UMask=0077

[Install]
WantedBy=multi-user.target
