DISCORD_TOKEN=
DATABASE_URL=sqlite:///./nex.db
# Bot owners: your Discord user IDs, not server IDs. Products/shop panels are owner-only; server administrators may configure settings.
OWNER_IDS=[]
DEFAULT_PREFIX=!
# Publish slash commands automatically at startup.
SYNC_COMMANDS=true
# Upload/reuse the bundled application emojis automatically before connecting.
AUTO_LOAD_EMOJIS=true
# Optional: server IDs for immediate server-specific slash registration.
COMMAND_GUILD_IDS=[]
PRODUCT_ROOT=./private/products
