DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:8000/auth/callback
PUBLIC_URL=http://localhost:8000
DATABASE_URL=sqlite:///./nex.db
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
COOKIE_SECURE=false
# Bot owners: your Discord user IDs, not server IDs. Management is owner-only.
OWNER_IDS=[]
DEFAULT_PREFIX=!
# Publish slash commands automatically at startup.
SYNC_COMMANDS=true
# Optional: server IDs for immediate server-specific slash registration.
COMMAND_GUILD_IDS=[]
PRODUCT_ROOT=./private/products
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=
